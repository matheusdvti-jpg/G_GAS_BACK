# Com DJANGO_DEBUG=False o processo recusa a chave abaixo e a chave de banco de exemplo.
# No computador local use DJANGO_DEBUG=True. No ambiente publicado, troque as duas chaves.
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-com-pelo-menos-32-caracteres
DJANGO_DEBUG=False
DJANGO_DB_KEY=troque-esta-chave-do-banco
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens do painel. O CSRF também aceita esta lista.
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3000
